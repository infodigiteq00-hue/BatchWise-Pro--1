PORT=3001

# full = control server (super admin + accounts). hybrid = desktop app (proxies auth to CONTROL_API_URL).
APP_MODE=full

# Required when APP_MODE=hybrid — online control API (e.g. https://api.batchwisepro.com/api)
# CONTROL_API_URL=

# How long hybrid mode caches control-server session (ms). Pause takes effect after cache expires.
# CONTROL_SESSION_CACHE_MS=90000

# All app data (JSON + PDFs) — use an absolute path to store outside the repo
DATA_DIR=./data

# Comma-separated UI origins allowed to call the API (local dev defaults)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

SUPER_ADMIN_EMAIL=your-super-admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Digiteq
SUPER_ADMIN_COMPANY=Digiteq

# Password reset (link in email points here)
FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_EXPIRES_MINUTES=60

# Optional SMTP — if unset, reset links are logged to the server console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
